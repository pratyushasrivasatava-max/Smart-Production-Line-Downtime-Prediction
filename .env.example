# Application & Environment Setup
VITE_APP_NAME="Smart Production-Line Downtime Prediction"
VITE_APP_VERSION="2.4.0"
VITE_BROKER_MODE="local"
VITE_MQTT_HOST="localhost"
VITE_MQTT_PORT="1883"
VITE_SIMULATION_DEFAULT_SPEED="1"

# MQTT Broker (HiveMQ Local CE / Cloud)
BROKER_MODE=local
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CLIENT_ID=downtime_prediction_core_01

# Storage (SQLite WAL Mode)
SQLITE_DB_PATH=data/historical_telemetry.db
SQLITE_WAL_MODE=true
RETENTION_DAYS=30

# Predictive AI / ML Pipeline
MODEL_PATH=models/xgb_downtime_v2.4.joblib
INFERENCE_INTERVAL_SEC=2
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.60
RISK_THRESHOLD_CRITICAL=0.85
PREDICTION_HORIZON_MINUTES=30

# Alerting & Incident Notification
ALERT_COOLDOWN_MINUTES=3
AUTO_ESCALATION_MINUTES=3
ENABLE_WEBHOOK=false
ALERT_WEBHOOK_URL=

# Streamlit & FastAPI
API_PORT=8000
STREAMLIT_PORT=8501
