# Broker Configuration
BROKER_MODE=local # local | cloud
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# Cloud Broker (HiveMQ Cloud example)
# BROKER_MODE=cloud
# MQTT_HOST=your-cluster-id.s1.eu.hivemq.cloud
# MQTT_PORT=8883
# MQTT_USERNAME=factory_admin
# MQTT_PASSWORD=secret_token
# MQTT_TLS=true

# Storage
SQLITE_DB_PATH=data/historical_telemetry.db
SQLITE_WAL_MODE=true
RETENTION_DAYS=30

# Prediction & Inference
MODEL_PATH=models/xgb_downtime_v2.4.joblib
INFERENCE_INTERVAL_SEC=2
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.60
RISK_THRESHOLD_CRITICAL=0.85

# Optional Alert Webhooks / Notifications
ENABLE_WEBHOOK=false
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_COOLDOWN_MINUTES=3
